<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permisos para guardar archivos en Descargas -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32"/>
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29"/>
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyApplication">

        <activity
            android:name=".reportes.ReportesActivity"
            android:exported="false" />
        <activity
            android:name=".perfil.MiPerfilActivity"
            android:exported="false" />
        <activity
            android:name=".prestamos.RegistrarDevolucionActivity"
            android:exported="false" />
        <activity
            android:name=".prestamos.ListaSolicitudesActivity"
            android:exported="false" />
        <activity
            android:name=".prestamos.SolicitarPrestamoActivity"
            android:exported="false" />
        <activity
            android:name=".inventario.StockActivity"
            android:exported="false" />
        <activity
            android:name=".inventario.RegistrarSalidaActivity"
            android:exported="false" />
        <activity
            android:name=".inventario.RegistrarEntradaActivity"
            android:exported="false" />
        <activity
            android:name=".equipos.FormularioEquipoActivity"
            android:exported="false" />
        <activity
            android:name=".equipos.DetalleEquipoActivity"
            android:exported="false" />
        <activity
            android:name=".equipos.ListaEquiposActivity"
            android:exported="false" />
        <activity
            android:name=".usuarios.UsuariosActivity"
            android:exported="false" />
        <activity
            android:name=".Dashboard"
            android:exported="false" />
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
