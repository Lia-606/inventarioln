<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fondo3">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="24dp"
        android:clipToPadding="false">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_margin="8dp"
            android:padding="20dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="8dp"
            app:strokeColor="#DDDDDD"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Título -->
                <TextView
                    android:id="@+id/tvTituloSalida"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/salida_titulo"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#2c3e50"
                    android:gravity="center_horizontal"
                    android:drawableTop="@android:drawable/ic_menu_upload"
                    android:drawablePadding="8dp"
                    android:paddingBottom="12dp" />

                <!-- Selector de equipos -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="8dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@android:drawable/ic_menu_agenda"
                        app:tint="#34495e"
                        android:layout_marginEnd="8dp"/>

                    <Spinner
                        android:id="@+id/spinnerEquiposSalida"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:minHeight="48dp"
                        android:padding="12dp"
                        android:layout_marginBottom="8dp" />
                </LinearLayout>

                <!-- Campo Cantidad -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="12dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@android:drawable/ic_menu_sort_by_size"
                        app:tint="#34495e"
                        android:layout_marginEnd="8dp"/>

                    <EditText
                        android:id="@+id/edtCantidadSalida"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:inputType="number"
                        android:minHeight="48dp"
                        android:padding="12dp"
                        android:hint="@string/salida_hint_cantidad"
                        android:contentDescription="@string/salida_hint_cantidad"
                        android:background="@android:drawable/editbox_background" />
                </LinearLayout>

                <!-- Motivo de salida -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="12dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@android:drawable/ic_menu_help"
                        app:tint="#34495e"
                        android:layout_marginEnd="8dp"/>

                    <Spinner
                        android:id="@+id/spnMotivo"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:minHeight="48dp"
                        android:padding="12dp" />
                </LinearLayout>

                <!-- Responsable -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="12dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@android:drawable/ic_menu_myplaces"
                        app:tint="#34495e"
                        android:layout_marginEnd="8dp"/>

                    <EditText
                        android:id="@+id/edtResponsableSalida"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="@string/salida_hint_responsable"
                        android:inputType="textPersonName"
                        android:minHeight="48dp"
                        android:padding="12dp"
                        android:background="@android:drawable/editbox_background"
                        android:textColor="@android:color/black" />
                </LinearLayout>

                <!-- Botón registrar -->
                <Button
                    android:id="@+id/btnRegistrarSalida"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/salida_btn_registrar"
                    android:layout_marginTop="20dp"
                    android:textColor="@android:color/white"
                    android:backgroundTint="#2980b9"
                    android:elevation="4dp"
                    android:minHeight="48dp"
                    android:drawableStart="@android:drawable/ic_menu_save"
                    android:drawablePadding="8dp"
                    android:textAllCaps="false"
                    android:contentDescription="@string/salida_btn_registrar" />
            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>
    </ScrollView>
</FrameLayout>
