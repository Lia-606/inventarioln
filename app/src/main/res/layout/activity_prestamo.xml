<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="16dp"
    android:gravity="center"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fondo1"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.cardview.widget.CardView
        android:id="@+id/cardSolicitarPrestamo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:elevation="4dp"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@android:drawable/ic_menu_send"
                app:tint="@android:color/holo_green_dark"
                android:layout_marginEnd="16dp" />

            <TextView
                android:id="@+id/btnSolicitarPrestamo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/prestamo_titulo_solicitud"
                android:textSize="18sp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:id="@+id/cardListaSolicitudes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:elevation="4dp"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@android:drawable/ic_menu_agenda"
                app:tint="@android:color/holo_blue_dark"
                android:layout_marginEnd="16dp" />

            <TextView
                android:id="@+id/btnListaSolicitudes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/prestamo_lista_titulo"
                android:textSize="18sp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:id="@+id/cardRegistrarDevolucion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:elevation="4dp"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@android:drawable/ic_menu_revert"
                app:tint="@android:color/holo_red_dark"
                android:layout_marginEnd="16dp" />

            <TextView
                android:id="@+id/btnRegistrarDevolucion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/prestamo_devolucion_titulo"
                android:textSize="18sp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:elevation="4dp"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@android:drawable/ic_menu_info_details"
                app:tint="@android:color/holo_orange_dark"
                android:layout_marginEnd="16dp" />

            <TextView
                android:id="@+id/btnListaDevoluciones"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/prestamo_lista_devoluciones_titulo"
                android:textSize="18sp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:id="@+id/cardVerMisSolicitudes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:elevation="4dp"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@android:drawable/ic_menu_view"
                android:layout_marginEnd="16dp"
                app:tint="@android:color/holo_purple" />

            <TextView
                android:id="@+id/btnVerMisSolicitudes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ver mis solicitudes"
                android:textSize="18sp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>



</LinearLayout>
