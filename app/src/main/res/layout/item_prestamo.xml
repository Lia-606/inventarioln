<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="12dp"
    android:foreground="?android:attr/selectableItemBackground"
    android:backgroundTint="#ffffff"
    app:cardCornerRadius="16dp"
    app:cardElevation="8dp"
    app:strokeColor="#e0e0e0"
    app:strokeWidth="1dp">

    <LinearLayout
        android:orientation="vertical"
        android:padding="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Título: Nombre del equipo -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_manage"
                app:tint="#2c3e50"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/tvEquipo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_equipo"
                android:textColor="#2c3e50"
                android:textSize="17sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Solicitante -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@android:drawable/ic_menu_myplaces"
                app:tint="#34495e"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/tvSolicitante"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_solicitante"
                android:textSize="14.5sp"
                android:textColor="#34495e" />
        </LinearLayout>

        <!-- Fecha solicitud -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@android:drawable/ic_menu_today"
                app:tint="#7f8c8d"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/tvFechaSolicitud"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_fecha"
                android:textSize="14sp"
                android:textColor="#7f8c8d" />
        </LinearLayout>

        <!-- Estado -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@android:drawable/ic_menu_info_details"
                app:tint="#e67e22"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/tvEstado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_estado"
                android:textSize="14sp"
                android:textColor="#e67e22" />
        </LinearLayout>

        <!-- Botones -->
        <LinearLayout
            android:id="@+id/layoutBotones"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="4dp">

            <Button
                android:id="@+id/btnAprobar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:minWidth="64dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="Aprobar"
                android:textAllCaps="false"
                android:backgroundTint="#27ae60"
                android:textColor="#FFFFFF"
                android:elevation="4dp"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnRechazar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:minWidth="64dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:layout_marginStart="12dp"
                android:text="Rechazar"
                android:textAllCaps="false"
                android:backgroundTint="#c0392b"
                android:textColor="#FFFFFF"
                android:elevation="4dp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
