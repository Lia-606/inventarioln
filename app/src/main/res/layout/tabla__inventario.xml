<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@android:color/white"
    android:padding="6dp"
    android:gravity="center_vertical"
    android:layout_marginBottom="1dp">

    <!-- Nombre del equipo -->
    <TextView
        android:id="@+id/tvInvNombreEquipo"
        android:layout_width="0dp"
        android:layout_weight="2"
        android:layout_height="wrap_content"
        android:text="Laptop Lenovo"
        android:gravity="center"
        android:padding="6dp"
        android:background="@drawable/borde_celda"
        android:textColor="@android:color/black"
        android:textStyle="bold" />

    <!-- Stock actual -->
    <TextView
        android:id="@+id/tvInvStock"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:text="7"
        android:gravity="center"
        android:padding="6dp"
        android:background="@drawable/borde_celda"
        android:textColor="@android:color/black" />

    <!-- Último movimiento (fecha) -->
    <TextView
        android:id="@+id/tvInvFecha"
        android:layout_width="0dp"
        android:layout_weight="1.5"
        android:layout_height="wrap_content"
        android:text="12/09/2025"
        android:gravity="center"
        android:padding="6dp"
        android:background="@drawable/borde_celda"
        android:textColor="@android:color/black" />

    <!-- Tipo de movimiento -->
    <TextView
        android:id="@+id/tvInvTipoMovimiento"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:text="Entrada"
        android:gravity="center"
        android:padding="6dp"
        android:background="@drawable/borde_celda"
        android:textColor="@android:color/black" />

    <!-- Responsable -->
    <TextView
        android:id="@+id/tvInvResponsable"
        android:layout_width="0dp"
        android:layout_weight="1.5"
        android:layout_height="wrap_content"
        android:text="Juan"
        android:gravity="center"
        android:padding="6dp"
        android:background="@drawable/borde_celda"
        android:textColor="@android:color/black" />

</LinearLayout>
