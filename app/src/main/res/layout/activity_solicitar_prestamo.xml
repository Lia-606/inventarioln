<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="48dp">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Título del formulario -->
        <TextView
            android:id="@+id/tvTitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/prestamo_titulo_solicitud"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:gravity="center_horizontal"
            android:layout_marginBottom="16dp" />

        <!-- Spinner con equipos -->
        <Spinner
            android:id="@+id/spinnerEquipos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:prompt="@string/prestamo_spinner_seleccionar_equipo"
            android:contentDescription="@string/prestamo_spinner_seleccionar_equipo" />

        <!-- Observaciones -->
        <EditText
            android:id="@+id/edtObservaciones"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Observaciones (opcional)"
            android:inputType="textMultiLine"
            android:minLines="3"
            android:layout_marginTop="12dp" />

        <!-- Botón de solicitud -->
        <Button
            android:id="@+id/btnSolicitar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/prestamo_btn_solicitar"
            android:layout_marginTop="20dp"
            android:contentDescription="@string/prestamo_btn_solicitar" />

    </LinearLayout>
</ScrollView>
