<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fondo3">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="24dp"
        android:clipToPadding="false">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_margin="8dp"
            android:padding="20dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="8dp"
            app:strokeColor="#DDDDDD"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Título -->
                <TextView
                    android:id="@+id/tvTituloDevolucion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/prestamo_devolucion_titulo"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#2c3e50"
                    android:gravity="center_horizontal"
                    android:drawableTop="@android:drawable/ic_menu_revert"
                    android:drawablePadding="8dp"
                    android:paddingBottom="12dp" />

                <!-- Label del spinner -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="8dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@android:drawable/ic_menu_agenda"
                        app:tint="#34495e"
                        android:layout_marginEnd="8dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/prestamo_spinner_prestamos_activos"
                        android:textSize="16sp"
                        android:textColor="#000000"/>
                </LinearLayout>

                <!-- Spinner de préstamos -->
                <Spinner
                    android:id="@+id/spinnerPrestamosActivos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:layout_marginTop="4dp"
                    android:padding="8dp" />

                <EditText
                    android:id="@+id/etCantidadDevolver"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:hint="Cantidad a devolver"
                    android:layout_marginTop="16dp"
                    android:minHeight="48dp"
                    android:padding="12dp" />


                <!-- Botón registrar devolución -->
                <Button
                    android:id="@+id/btnRegistrarDevolucion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:minHeight="48dp"
                    android:text="@string/prestamo_btn_registrar_devolucion"
                    android:textColor="@android:color/white"
                    android:backgroundTint="#27ae60"
                    android:elevation="4dp"
                    android:drawableStart="@android:drawable/ic_menu_save"
                    android:drawablePadding="8dp"
                    android:textAllCaps="false"
                    android:contentDescription="@string/prestamo_btn_registrar_devolucion" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </ScrollView>
</FrameLayout>
